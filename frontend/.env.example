VITE_API_URL=https://your-render-service.onrender.com/api

# Tạo một browser key riêng, bật Maps JavaScript API và giới hạn key theo HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your_browser_google_maps_key

# Tùy chọn: Map ID dùng cho Advanced Markers. Khi để trống sẽ dùng DEMO_MAP_ID ở môi trường local.
VITE_GOOGLE_MAPS_MAP_ID=
