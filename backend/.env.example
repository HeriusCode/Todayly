PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/todayly?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

# OpenStreetMap Overpass synchronization
# Có thể đổi endpoint; backend tự thử thêm máy chủ dự phòng khi endpoint này quá tải.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_CONTACT=your-email@example.com
FOOD_CACHE_HOURS=12

# Tùy chọn: dữ liệu phong phú (ảnh, đánh giá, giá, điện thoại, website).
# Bật Places API (New) trong Google Cloud và giới hạn key chỉ dùng cho Places API.
GOOGLE_PLACES_API_KEY=
